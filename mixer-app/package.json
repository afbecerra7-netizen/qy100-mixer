{
  "name": "qy100-mixer",
  "productName": "QY100 Mixer",
  "version": "0.1.0",
  "private": true,
  "description": "A one-screen mixer for the Yamaha QY100's internal parts, over XG SysEx",
  "license": "GPL-3.0-or-later",
  "main": "electron/main.cjs",
  "scripts": {
    "consola": "node scripts/copiar-consola.cjs",
    "app": "npm run consola && electron .",
    "comprobar": "npm run consola && QY_MIXER_AUTOCOMPROBAR=1 electron .",
    "package:mac": "npm run consola && electron-packager . \"QY100 Mixer\" --platform=darwin --arch=arm64 --out=release --overwrite --app-bundle-id=co.afbecerra.qy100-mixer --ignore=\"^/(release|pruebas|scripts|node_modules|\\.gitignore)($|/)\""
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "electron": "^33.2.1"
  }
}
